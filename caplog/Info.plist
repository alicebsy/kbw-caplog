<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPLOG_API_BASE_URL</key>
	<string>$(CAPLOG_API_BASE_URL)</string>
	<key>KAKAO_NATIVE_APP_KEY</key>
	<string>$(KAKAO_NATIVE_APP_KEY)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- 앱 화면이 라이트 전용으로 디자인되어 있어 시스템 다크모드를 따라가지 않습니다.
	     이 키를 지우면 iOS 기본 동작(시스템 설정 추종)으로 돌아갑니다. -->
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
</dict>
</plist>
